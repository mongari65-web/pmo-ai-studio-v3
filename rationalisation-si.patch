+
+  const toRows = () => apps.map(a => ({ Application:a.nom, Quadrant:a.quadrant, "Fit technique":a.fitTechnique, "Fit fonctionnel":a.fitFonctionnel, Recommandation:a.recommandation, Échéance:a.echeance }))
